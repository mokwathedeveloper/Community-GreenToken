# Community GreenToken — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ─── Stellar Network ────────────────────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ─── Deployed Contract IDs (fill in after running deploy.sh) ────
NEXT_PUBLIC_GREEN_TOKEN_CONTRACT_ID=C...
NEXT_PUBLIC_ACTION_REGISTRY_CONTRACT_ID=C...
NEXT_PUBLIC_REWARD_MANAGER_CONTRACT_ID=C...

# ─── Platform Admin Keypair (SERVER SIDE ONLY — never NEXT_PUBLIC_) ────
# Generate with: stellar keys generate --global admin
# Fund on testnet: https://friendbot.stellar.org?addr=YOUR_PUBLIC_KEY
STELLAR_ADMIN_PUBLIC_KEY=G...
STELLAR_ADMIN_SECRET_KEY=S...

# ─── Supabase ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ─── Stripe (SaaS Billing) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# ─── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
